[Desktop Entry]
Type=Application
Name=OffGrid Comms
Comment=HF mail (Mercury), Reticulum HF and mesh control panel
Exec=@APP_DIR@/run.sh
Icon=@APP_DIR@/assets/icon.png
Terminal=false
Categories=HamRadio;Network;
